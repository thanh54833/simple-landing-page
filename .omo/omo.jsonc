    "plan-reviewer": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "medium" }
  },
  "[opencode]": {
    "agents": {
      "sisyphus": { "model": "opencode-go/muse-spark-1.3-contributor" },
      "hephaestus": { "model": "opencode-go/muse-spark-1.3-contributor" },
      "oracle": { "model": "opencode-go/muse-spark-1.3-contributor" },
      "prometheus": { "model": "opencode-go/muse-spark-1.3-contributor" },
