      "multimodal-looker": { "model": "opencode-go/muse-spark-1.3-contributor" },
      "sisyphus-junior": { "model": "opencode-go/muse-spark-1.3-contributor" },
      "plan-consultant": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "high" },
      "plan-reviewer": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "high" }
    },
    "categories": {
      "deep-low": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "high" },
      "deep-high": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "high" },
