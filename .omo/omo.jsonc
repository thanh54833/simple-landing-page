{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  // Shared base: native + opencode đều thấy. Mirror từ .opencode/oh-my-openagent.json
  // (model opencode-go/muse-spark-1.3-contributor, temperature <=0.3 → reasoning high, còn lại medium)
  "categories": {
    "quick": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "medium" },
    "unspecified-low": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "medium" },
    "unspecified-high": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "high" },
