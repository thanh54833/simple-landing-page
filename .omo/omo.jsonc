    "visual-engineering": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "medium" },
    "artistry": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "medium" },
    "writing": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "medium" },
    "deep-low": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "high" },
    "deep-high": { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "high" },
